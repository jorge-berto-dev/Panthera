# python3-gi + gir1.2-gtk-3.0: os 4 apps GTK (Central, Loja, Atualizador,
# Boas-vindas) fazem "import gi", e o hook 0200 valida o gtk.css com Gtk.CssProvider.
# Chegavam so por dependencia do clamtk; agora sao explicitos.
python3-gi
gir1.2-gtk-3.0
calamares
fonts-inter
fonts-noto-core
hunspell-pt-br
# rsvg-convert: o hook 0200 precisa converter o wallpaper.svg em PNG. O XFCE e o
# slick-greeter nao aceitam SVG, e sem isso a ISO sai sem papel de parede.
librsvg2-bin
xdg-utils
# rsync: o Backup Panthera copia a pasta pessoal para pendrive com ele
rsync
