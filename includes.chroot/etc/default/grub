# /etc/default/grub trecho Panthera (ODT Secao 32)
# Teste apos install: sudo update-grub; reboot mostra Panthera + Windows se lado a lado
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE=menu
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=2 mitigations=auto audit=1 apparmor=1 security=apparmor"
GRUB_THEME=/boot/grub/themes/panthera/theme.txt
GRUB_DISABLE_OS_PROBER=false
