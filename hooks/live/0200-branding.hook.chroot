#!/bin/bash
# hooks/live/0200-branding.hook.chroot - tema Panthera FASE 3 (ODT Secao 15.3 + 20.3 + 25.1)
# Roda DENTRO do chroot. Usa /usr/share/panthera-src (via includes) com fallback host.
# Instala: GTK, icones, wallpaper, GRUB, Plymouth, greeter, skel.
set -e
mkdir -p /var/log/panthera
echo "[0200-branding] $(date -u +%Y-%m-%dT%H:%M:%SZ) inicio" | tee -a /var/log/panthera-hooks.log
# Descobre onde estao as fontes (chroot vs host)
SRC="/usr/share/panthera-src"
if [ ! -d "$SRC/branding" ] && [ -d branding ]; then SRC="."; fi
B="$SRC/branding"

# Fonte faltando REPROVA o build. Na v1.1-kits isto era so um AVISO: as fontes
# nao chegaram no chroot, o gtk.css nao foi copiado, e a ISO foi publicada com
# o tema do Debian 12 e o log saying "OK branding". Promessa nao cumprida com
# build verde e o pior resultado possivel.
[ -d "$B" ] || { echo "[0200-branding] FALHA: sem fontes em $B. Sem elas a ISO sai sem tema." | tee -a /var/log/panthera-hooks.log; exit 1; }
[ -f "$B/themes/Panthera/gtk.css" ] || { echo "[0200-branding] FALHA: falta gtk.css em $B" | tee -a /var/log/panthera-hooks.log; exit 1; }
[ -f "$B/themes/Panthera/index.theme" ] || { echo "[0200-branding] FALHA: falta index.theme em $B (GTK3 ignora o tema)" | tee -a /var/log/panthera-hooks.log; exit 1; }
[ -f "$B/wallpaper.svg" ] || { echo "[0200-branding] FALHA: falta wallpaper.svg em $B" | tee -a /var/log/panthera-hooks.log; exit 1; }
# wallpaper.png e o asset oficial, gerado da identidade-visual.png (pantera +
# slogan sobre fundo #0B111C). Commitado pronto para nao depender de renderizar
# SVG no build: deterministico, sempre igual.
[ -f "$B/wallpaper.png" ] || { echo "[0200-branding] FALHA: falta wallpaper.png em $B" | tee -a /var/log/panthera-hooks.log; exit 1; }

# 1. Tema GTK Panthera (paleta oficial Secao 4.1)
mkdir -p /usr/share/themes/Panthera/gtk-3.0 /usr/share/themes/Panthera
cp "$B/themes/Panthera/index.theme" /usr/share/themes/Panthera/index.theme
cp "$B/themes/Panthera/gtk.css" /usr/share/themes/Panthera/gtk-3.0/gtk.css
cp "$B/themes/Panthera/gtk.css" /usr/share/themes/Panthera/gtk.css
# Reprova o build se o CSS nao compilar no GTK3. GTK3 nao suporta var() (isso e
# GTK4): um unico var() invalido faz o GTK descartar o gtk.css inteiro e a ISO
# silenciosamente sai com o tema do Debian 12. Mesma politica do 0300 com o JSON.
if [ -f /usr/share/themes/Panthera/gtk-3.0/gtk.css ]; then
  if python3 -c "
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk
Gtk.CssProvider().load_from_path('/usr/share/themes/Panthera/gtk-3.0/gtk.css')
" 2>/tmp/panthera-css.err; then
    echo "[0200-branding] OK gtk.css compila no GTK3" | tee -a /var/log/panthera-hooks.log
  else
    echo "[0200-branding] FALHA: gtk.css invalido no GTK3, tema seria descartado" | tee -a /var/log/panthera-hooks.log
    cat /tmp/panthera-css.err | tee -a /var/log/panthera-hooks.log
    exit 1
  fi
fi

# 2. Icones Panthera (outline 1.5px #1D83FF, herda Papirus)
mkdir -p /usr/share/icons/Panthera
if [ -d "$B/icons/Panthera" ]; then
  cp -r "$B/icons/Panthera/"* /usr/share/icons/Panthera/ || true
  gtk-update-icon-cache /usr/share/icons/Panthera 2>/dev/null || true
fi

# 3. Wallpaper oficial 1920x1080 (pantera + slogan, da identidade-visual.png)
mkdir -p /usr/share/backgrounds/panthera
cp "$B/wallpaper.svg" /usr/share/backgrounds/panthera/wallpaper.svg
cp "$B/wallpaper.png" /usr/share/backgrounds/panthera/wallpaper.png
chmod 644 /usr/share/backgrounds/panthera/wallpaper.png

# 4. GRUB 1024x768 (fundo #0B111C, selecao #1D83FF)
mkdir -p /boot/grub/themes/panthera
if [ -f "$B/grub/theme.txt" ]; then
  cp "$B/grub/theme.txt" /boot/grub/themes/panthera/theme.txt
fi
# background.png e commitado (gerado da identidade). O SVG e fallback.
if [ -f "$B/boot/grub-background.png" ]; then
  cp "$B/boot/grub-background.png" /boot/grub/themes/panthera/background.png
elif command -v rsvg-convert >/dev/null 2>&1; then
  rsvg-convert -w 1024 -h 768 /usr/share/backgrounds/panthera/wallpaper.svg -o /boot/grub/themes/panthera/background.png 2>/dev/null || true
elif command -v convert >/dev/null 2>&1; then
  convert /usr/share/backgrounds/panthera/wallpaper.svg -resize 1024x768! /boot/grub/themes/panthera/background.png 2>/dev/null || true
else
  echo "[0200-branding] sem background.png e sem rsvg/convert: GRUB usa desktop-color #0B111C" | tee -a /var/log/panthera-hooks.log
fi

# 5. Plymouth (fundo #0B111C + barra #1D83FF)
mkdir -p /usr/share/plymouth/themes/panthera
if [ -f "$B/plymouth/panthera.plymouth" ]; then
  cp "$B/plymouth/panthera.plymouth" /usr/share/plymouth/themes/panthera/panthera.plymouth
fi
if [ -f "$B/plymouth/panthera.script" ]; then
  cp "$B/plymouth/panthera.script" /usr/share/plymouth/themes/panthera/panthera.script
fi
# Logo da pantera para o splash (da identidade-visual.png, nao do placeholder).
# O boot/panther-logo-300.png e commitado; o SVG antigo e fallback.
if [ -f "$B/boot/panther-logo-300.png" ]; then
  cp "$B/boot/panther-logo-300.png" /usr/share/plymouth/themes/panthera/logo.png
elif [ -f "$B/icons/Panthera/logo.svg" ]; then
  if command -v rsvg-convert >/dev/null 2>&1; then
    rsvg-convert -w 200 -h 200 "$B/icons/Panthera/logo.svg" -o /usr/share/plymouth/themes/panthera/logo.png 2>/dev/null || true
  else
    cp "$B/icons/Panthera/logo.svg" /usr/share/plymouth/themes/panthera/logo.svg 2>/dev/null || true
  fi
fi
[ -f /usr/share/plymouth/themes/panthera/logo.png ] || { echo "[0200-branding] FALHA: sem logo.png para o Plymouth" | tee -a /var/log/panthera-hooks.log; exit 1; }
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  plymouth-set-default-theme -R panthera 2>/dev/null || plymouth-set-default-theme panthera 2>/dev/null || true
fi

# 6. Tela de login slick-greeter (fonte Inter, sem ingles)
mkdir -p /etc/lightdm
if [ -f "$B/slick-greeter.conf" ]; then
  cp "$B/slick-greeter.conf" /etc/lightdm/slick-greeter.conf
else
  cat > /etc/lightdm/slick-greeter.conf <<EOF
[Greeter]
background=/usr/share/backgrounds/panthera/wallpaper.svg
theme-name=Panthera
icon-theme-name=Panthera
font-name=Inter 11
show-hostname=true
EOF
fi

# 7. Skel: tema padrao do usuario (nunca /usr /etc direto - RNF005)
mkdir -p /etc/skel/.config/panthera
if [ -d "$B/skel" ]; then
  cp "$B/skel/"* /etc/skel/.config/panthera/ 2>/dev/null || true
fi
echo "[0200-branding] OK tema+icones+grub+plymouth+greeter" | tee -a /var/log/panthera-hooks.log

# 8. APLICAR de verdade (a versao anterior so copiava arquivos: o XFCE continuava
#    com o tema/icones/papel de parede do Debian 12). Gerado por deve ser ~/.config,
#    nunca /usr ou /etc direto (RNF005).
WALL_SVG=/usr/share/backgrounds/panthera/wallpaper.svg
WALL_PNG=/usr/share/backgrounds/panthera/wallpaper.png
# O PNG e commitado; so renderiza do SVG se alguem apagar o PNG no futuro.
if [ ! -f "$WALL_PNG" ]; then
  if command -v rsvg-convert >/dev/null 2>&1 && [ -f "$WALL_SVG" ]; then
    rsvg-convert -w 1920 -h 1080 "$WALL_SVG" -o "$WALL_PNG" || true
  elif command -v convert >/dev/null 2>&1 && [ -f "$WALL_SVG" ]; then
    convert "$WALL_SVG" -resize 1920x1080! "$WALL_PNG" || true
  fi
fi
# Nem o XFCE nem o slick-greeter aceitam SVG. Sem PNG nao ha papel de parede,
# e a v1.1.1 saiu assim com um AVISO. Agora reprova: librsvg2-bin esta na base
# justamente para este passo existir.
[ -f "$WALL_PNG" ] || { echo "[0200-branding] FALHA: sem wallpaper.png (XFCE nao usa SVG). rsvg-convert ou convert nao funcionou." | tee -a /var/log/panthera-hooks.log; exit 1; }

mkdir -p /usr/share/backgrounds/xfce
cat > /usr/share/backgrounds/xfce/panthera.xml <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE wallpapers SYSTEM "xfce-wallpaper.dtd">
<wallpapers>
  <wallpaper deleted="false">
    <name>Panthera</name>
     <filename>$WALL_PNG</filename>
    <options>stretched</options>
    <shade_type>solid</shade_type>
    <pcolor>#0B111C</pcolor>
    <scolor>#0B111C</scolor>
  </wallpaper>
</wallpapers>
EOF

aplicar_home() {
  H="$1"
  mkdir -p "$H/.config/gtk-3.0" "$H/.config/xfce4/xfconf/xfce-perchannel-xml" "$H/.config/xfwm4"
  cat > "$H/.config/gtk-3.0/settings.ini" <<EOF
[Settings]
gtk-theme-name=Panthera
gtk-icon-theme-name=Panthera
gtk-font-name=Inter 10
EOF
  cat > "$H/.gtkrc-2.0" <<EOF
gtk-theme-name="Panthera"
gtk-icon-theme-name="Panthera"
gtk-font-name="Inter 10"
EOF
  # ATENCAO: o diretorio certo e xfce-perchannel-xml. A versao anterior escrevia
  # em xfce-perchannel-desktop, que o xfconfd ignora: por isso o papel de parede
  # nunca aplicava e a ISO saia com o fundo padrao do Debian.
  cat > "$H/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="color1" type="string" value="#0B111C"/>
          <property name="image-style" type="int" value="2"/>
          <property name="last-image" type="string" value="$WALL_PNG"/>
        </property>
      </property>
    </property>
  </property>
</channel>
EOF
  # O xfsettingsd (que roda em toda sessao XFCE) le o tema DESTE canal e
  # sobrescreve o settings.ini via XSETTINGS. Sem este arquivo, o settings.ini
  # sozinho nao adianta: a janela abria branca com o tema padrao.
  cat > "$H/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Panthera"/>
    <property name="IconThemeName" type="string" value="Panthera"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="FontName" type="string" value="Inter 10"/>
    <property name="CursorThemeName" type="string" value="Adwaita"/>
  </property>
  <property name="Xft" type="empty">
    <property name="Antialias" type="int" value="1"/>
    <property name="Hinting" type="int" value="1"/>
    <property name="HintStyle" type="string" value="hintslight"/>
    <property name="RGBA" type="string" value="rgb"/>
  </property>
</channel>
EOF
  cat > "$H/.config/xfwm4/xfwm4rc" <<EOF
active_title_color=#1D83FF
active_title_text_color=#FFFFFF
inactive_title_color=#141B2B
inactive_title_text_color=#8490A4
title_shadow_active=false
title_shadow_inactive=false
button_offset=4
button_spacing=2
shadow_opacity=0
EOF
}

# O caminho que realmente importa e o /etc/skel: verificado na v1.1-kits que
# /home vem VAZIO no squashfs, porque o live-boot cria o usuario do Live no
# primeiro boot com "useradd -m", e o useradd copia o skel. Assim o mesmo
# branding vale para o Live e para qualquer usuario instalado pelo Calamares.
aplicar_home /etc/skel
# O laco abaixo e uma garantia extra: se alguma vez o usuario do Live for criado
# no build em vez do boot, o branding e aplicado nele tambem.
for LIVE_USER in user panthera; do
  if [ -d "/home/$LIVE_USER" ]; then
    aplicar_home "/home/$LIVE_USER"
    chown -R "$LIVE_USER:$LIVE_USER" "/home/$LIVE_USER/.config" "/home/$LIVE_USER/.gtkrc-2.0" 2>/dev/null || true
    echo "[0200-branding] aplicado em /home/$LIVE_USER" | tee -a /var/log/panthera-hooks.log
  fi
done
echo "[0200-branding] OK tema+icones+wallpaper+xfwm aplicados" | tee -a /var/log/panthera-hooks.log
