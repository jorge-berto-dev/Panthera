#!/bin/bash
# hooks/live/0250-pool.hook.chroot - pool offline de .deb dentro da propria ISO
# Roda DENTRO do chroot. Idempotente.
#
# Por que isso e obrigatorio, e nao opcional: o Firefox saiu da base nativa.
# Sem o pool, um usuario sem internet que installa a Panthera fica com um
# desktop SEM NENHUM navegador e sem como obter um. O pool garante que o
# navegador volta a funcionar com a ISO na mao e o cabo de rede desconectado.
#
# O pool nao baixa so os pacotes de pool_offline. Ele usa
# --download-only apontando o cache para o pool, o que traz junto TODA
# dependencia que ainda nao esta na base. Na v1.1-kits o pool tinha so os 2
# .deb e faltava libevent-2.1-7 e debianutils: a instalacao offline falhava com
# "E: Unable to fetch". Declarar as dependencias na mao e fragile; deixar o apt
# resolver e o que faz a promessa do catalogo ser verdadeira.
set -e
mkdir -p /var/log/panthera
echo "[0250-pool] $(date -u +%Y-%m-%dT%H:%M:%SZ) inicio" | tee -a /var/log/panthera-hooks.log
CAT=/usr/share/panthera-store/catalogo.json
POOL=/var/cache/panthera-pool

if [ ! -f "$CAT" ]; then
  echo "[0250-pool] FALHA: sem catalogo em $CAT. Sem catalogo nao ha pool, e sem pool a ISO nao tem navegador offline." | tee -a /var/log/panthera-hooks.log
  exit 1
fi

# pool_offline vive no catalogo: uma fonte de verdade so.
PKGS=$(python3 -c "
import json
cat = json.load(open('$CAT'))
print(' '.join(cat.get('pool_offline', [])))
" 2>/dev/null || true)

if [ -z "$PKGS" ]; then
  echo "[0250-pool] FALHA: pool_offline vazio no catalogo" | tee -a /var/log/panthera-hooks.log
  exit 1
fi

mkdir -p "$POOL/partial"
chmod 777 "$POOL" "$POOL/partial"
echo "[0250-pool] baixando (com dependencias): $PKGS" | tee -a /var/log/panthera-hooks.log
# shellcheck disable=SC2086
if ! apt-get install -y --download-only -o Dir::Cache::archives="$POOL" $PKGS >> /var/log/panthera-pool.log 2>&1; then
  echo "[0250-pool] FALHA ao montar o pool, ve /var/log/panthera-pool.log" | tee -a /var/log/panthera-hooks.log
  exit 1
fi
rm -f "$POOL/partial"/* 2>/dev/null || true

# Verificacao dura: o pool tem de resolver o navegador SEM NADA de rede. Nao e
# aviso: uma ISO que promete "instalavel sem internet" e falha seria mentira
# do catalogo, e o build tem de reprovar.
SIM=$(apt-get install -s --no-download "$POOL"/*.deb 2>&1 || true)
if echo "$SIM" | grep -qE "^(E:|Unable to (acquire|fetch)|Err:)"; then
  echo "[0250-pool] FALHA: o pool NAO cobre a instalacao offline" | tee -a /var/log/panthera-hooks.log
  echo "$SIM" | grep -E "^(E:|Unable to|Err:)" | sed 's/^/[0250-pool]   /' | tee -a /var/log/panthera-hooks.log
  exit 1
fi

N=$(ls -1 "$POOL"/*.deb 2>/dev/null | wc -l)
TAM=$(du -sh "$POOL" | cut -f1)
echo "[0250-pool] OK $N .deb, $TAM, instala offline sem buscar nada na rede" | tee -a /var/log/panthera-hooks.log
ls -1 "$POOL"/*.deb | sed 's|.*/|[0250-pool]   |' | tee -a /var/log/panthera-hooks.log
