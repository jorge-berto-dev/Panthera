#!/bin/bash
# hooks/live/0250-pool.hook.chroot - pool offline de .deb dentro da propria ISO
# Roda DENTRO do chroot. Idempotente.
#
# Por que isso e obrigatorio, e nao opcional: o Firefox saiu da base nativa.
# Sem o pool, um usuario sem internet que installa a Panthera fica com um
# desktop SEM NENHUM navegador e sem como obter um.
#
# O metodo e deliberadamente sem depender de comportamento interno do apt:
#   1. simula e pergunta ao apt a LISTA exata do que ele instalaria
#   2. baixa exatamente essa lista, versao por versao
#   3. simula de novo com os .deb do pool e exige que nao sobre NADA a instalar
# A v1.1.1 tentava resolver isso com "apt-get install --download-only
# -o Dir::Cache::archives=$POOL" e a checagem seguinte acusava "Unable to fetch
# some archives" sem dizer qual pacote. Aqui, se faltar algo, o log nomeia.
set -e
mkdir -p /var/log/panthera
echo "[0250-pool] $(date -u +%Y-%m-%dT%H:%M:%SZ) inicio" | tee -a /var/log/panthera-hooks.log
CAT=/usr/share/panthera-store/catalogo.json
POOL=/var/cache/panthera-pool

if [ ! -f "$CAT" ]; then
  echo "[0250-pool] FALHA: sem catalogo em $CAT. Sem catalogo nao ha pool, e sem pool a ISO nao tem navegador offline." | tee -a /var/log/panthera-hooks.log
  exit 1
fi

# pool_offline vive no catalogo: uma fonte de verdade so.
PKGS=$(python3 -c "
import json
cat = json.load(open('$CAT'))
print(' '.join(cat.get('pool_offline', [])))
" 2>/dev/null || true)
if [ -z "$PKGS" ]; then
  echo "[0250-pool] FALHA: pool_offline vazio no catalogo" | tee -a /var/log/panthera-hooks.log
  exit 1
fi

# ---- passo 1: a lista exata do que o apt instalaria
QUER=$(apt-get install -s $PKGS 2>/dev/null | awk '/^Inst /{print $2}' | sort -u)
if [ -z "$QUER" ]; then
  echo "[0250-pool] FALHA: apt nao resolveu nada para: $PKGS" | tee -a /var/log/panthera-hooks.log
  exit 1
fi
echo "[0250-pool] $(echo "$QUER" | wc -w) pacotes a baixar:" | tee -a /var/log/panthera-hooks.log
echo "$QUER" | tr ' ' '\n' | sed 's/^/[0250-pool]   /' | tee -a /var/log/panthera-hooks.log

# ---- passo 2: baixa exatamente essa lista
mkdir -p "$POOL"
rm -f "$POOL"/*.deb
cd "$POOL"
# shellcheck disable=SC2086
if ! apt-get download $QUER >> /var/log/panthera-pool.log 2>&1; then
  echo "[0250-pool] FALHA ao baixar, ve /var/log/panthera-pool.log" | tee -a /var/log/panthera-hooks.log
  exit 1
fi

# ---- passo 3: confere que o pool sozinho resolve, sem depender da rede
# A guarda vive em scripts/panthera-pool-check.sh e tem suite propria
# (tests/test-pool-check.sh), porque a versao anterior desta logica reprovou o
# build com o pool completo na mao: tratava a lista "Inst" do apt como falha,
# sendo que "Inst" sao os pacotes que o apt instalaria.
if [ ! -x /usr/share/panthera-src/panthera-pool-check.sh ]; then
  echo "[0250-pool] FALHA: guarda /usr/share/panthera-src/panthera-pool-check.sh ausente" | tee -a /var/log/panthera-hooks.log
  exit 1
fi
# SEM "| tee" aqui de proposito. O status de um pipeline e o do ultimo comando, e
# o tee sempre da sucesso: a v1.1.3 reprovou na guarda, o pipe engoleu a falha e
# a ISO foi publicada prometendo instalacao offline que nao existia. A guarda
# escreve no log por conta propria.
if bash /usr/share/panthera-src/panthera-pool-check.sh "$POOL" >> /var/log/panthera-hooks.log 2>&1; then
  echo "[0250-pool] guarda: pool instalavel sem rede" | tee -a /var/log/panthera-hooks.log
else
  echo "[0250-pool] FALHA: pool nao instala sozinho, sem internet" | tee -a /var/log/panthera-hooks.log
  exit 1
fi

N=$(ls -1 "$POOL"/*.deb 2>/dev/null | wc -l)
TAM=$(du -sh "$POOL" | cut -f1)
echo "[0250-pool] OK $N .deb, $TAM, instala offline sem buscar nada na rede" | tee -a /var/log/panthera-hooks.log
ls -1 "$POOL"/*.deb | sed 's|.*/|[0250-pool]   |' | tee -a /var/log/panthera-hooks.log
