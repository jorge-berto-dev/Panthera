#!/bin/bash
# hooks/live/0700-bootmenu.hook.binary - menu de boot Panthera + autoboot
# Roda no HOST, DEPOIS do estagio binary, ANTES de gerar a ISO.
# (hook .binary enxerga a pasta binary/; hook .chroot nao enxerga.)
#
# O que faz, e por que existe:
#  1. AUTOBOOT. O live-build gera o menu parado esperando ENTER para sempre.
#     Que nem o Mint: mostra o menu, conta 5 segundos e inicia sozinho.
#  2. TEMA GRUB. O hook 0200 instala o tema em /boot/grub/themes/panthera DENTRO
#     do chroot, mas o grub.cfg da ISO e gerado pelo live-build sem nenhuma
#     referencia a ele. Sem este hook, o boot mostra o menu padrao do Debian.
#  3. MARCA. Troca "Debian GNU/Linux" por "Panthera" nos titulos do menu.
#
# Se nao achar NENHUM config de bootloader, REPROVA: menu sem marca e sem
# autoboot e exatamente o que a v1.1.8 entregou.
set -e
# Ancoragem: hook binario pode rodar com CWD diferente da raiz do projeto
# (na v1.2.0 o CWD nao tinha binary/ e o hook reprovou sem achar nada).
# A raiz e sempre 3 niveis acima deste arquivo: config/hooks/live/xxxx.
ROOT="$(cd "$(dirname "$0")/../../.." 2>/dev/null && pwd)"
if [ -z "$ROOT" ] || [ ! -d "$ROOT/binary" ]; then
  # fallback: procura binary/ para cima a partir do CWD
  D="$PWD"
  while [ "$D" != "/" ]; do
    if [ -d "$D/binary" ]; then ROOT="$D"; break; fi
    D="$(dirname "$D")"
  done
fi
LOG="$ROOT/binary/bootmenu-panthera.log"
mkdir -p "$ROOT/binary"
{
  echo "[0700-bootmenu] $(date -u +%Y-%m-%dT%H:%M:%SZ) inicio"
  echo "[0700-bootmenu] CWD=$(pwd) ROOT=$ROOT hook=$0"
  echo "[0700-bootmenu] conteudo de binary/:"
  find "$ROOT/binary" -maxdepth 2 2>/dev/null | head -30
} | tee "$LOG"
BIN="$ROOT/binary"
ACHOU=0

# ---------- Legacy: syslinux/isolinux ----------
for CFG in "$BIN/isolinux/isolinux.cfg" "$BIN/isolinux/live.cfg" "$BIN/isolinux/menu.cfg"; do
  [ -f "$CFG" ] || continue
  ACHOU=1
  cp "$CFG" "$CFG.panthera-bak"
  # TIMEOUT em decimos de segundo: 50 = 5s, que nem o Mint
  if grep -qi "^TIMEOUT" "$CFG"; then
    sed -i -E 's/^TIMEOUT.*/TIMEOUT 50/i' "$CFG"
  else
    printf '\nTIMEOUT 50\n' >> "$CFG"
  fi
  # titulo do menu (cria se nao existir: o TITLE pode morar em outro .cfg)
  if grep -qi "^MENU TITLE" "$CFG"; then
    sed -i -E 's/^MENU TITLE.*/MENU TITLE Panthera - LIBERDADE PARA O SEU MUNDO/i' "$CFG"
  else
    printf 'MENU TITLE Panthera - LIBERDADE PARA O SEU MUNDO\n' >> "$CFG"
  fi
  echo "[0700-bootmenu] syslinux autoboot 5s em $CFG" | tee -a "$LOG"
done
for CFG in "$BIN/isolinux/live.cfg" "$BIN/isolinux/live.cfg.in"; do
  [ -f "$CFG" ] || continue
  sed -i 's/Debian GNU\/Linux/Panthera/g' "$CFG"
  echo "[0700-bootmenu] marca Panthera em $CFG" | tee -a "$LOG"
done

# ---------- UEFI: GRUB ----------
# O grub.cfg REAL so existe DEPOIS do "lb build" (verificado na v1.2.1: este
# hook criou um stub que a geracao real sobrescreveu, e a ISO saiu com o menu
# Debian). Entao aqui so PRE-POSICIONA os assets do tema em binary/; quem
# aplica o patch e scripts/panthera-grub-patch.sh, chamado pelo build-iso.sh
# depois do lb build, seguido de "lb binary_iso".
THEMEDIR="$BIN/boot/grub/themes/panthera"
mkdir -p "$THEMEDIR"
SRC=""
[ -d "$ROOT/config/includes.chroot/usr/share/panthera-src/branding" ] && SRC="$ROOT/config/includes.chroot/usr/share/panthera-src/branding"
[ -d "$ROOT/branding" ] && [ -z "$SRC" ] && SRC="$ROOT/branding"
if [ -n "$SRC" ] && [ -f "$SRC/grub/theme.txt" ] && [ -f "$SRC/boot/grub-background.png" ]; then
  cp "$SRC/grub/theme.txt" "$THEMEDIR/theme.txt"
  cp "$SRC/boot/grub-background.png" "$THEMEDIR/background.png"
  echo "[0700-bootmenu] assets do tema GRUB posicionados (patch vem depois do lb build)" | tee -a "$LOG"
else
  echo "[0700-bootmenu] FALHA: sem theme.txt/background.png em $SRC para posicionar" | tee -a "$LOG"
  exit 1
fi

if [ "$ACHOU" -eq 0 ]; then
  echo "[0700-bootmenu] FALHA: nenhum config de bootloader em binary/ (nem isolinux, nem grub)" | tee -a "$LOG"
  exit 1
fi
echo "[0700-bootmenu] OK" | tee -a "$LOG"
